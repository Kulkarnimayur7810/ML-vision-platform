# Placeholders only. Real values go in .env.local (git-ignored) for development,
# or in Vercel → Project → Settings → Environment Variables (mark them Sensitive) for production.
# Nothing here is ever prefixed NEXT_PUBLIC_: every value is server-side only.

# --- Required -----------------------------------------------------------
# PostgreSQL connection string. Supabase: Project → Connect → "Transaction pooler" (port 6543).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# Random secret used to sign file links. Generate: openssl rand -hex 32. Change it to invalidate all issued links.
APP_SECRET=replace-with-64-random-hex-characters

# --- Storage (required on Vercel; its disk is not persistent) ------------
# local = a folder on this machine (development only) · s3 = any S3-compatible bucket
STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=./.local-storage
# S3_BUCKET=
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   (omit for AWS S3)
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=1        (set 0 for AWS S3 virtual-hosted style)

# --- Optional ------------------------------------------------------------
# Session lifetime in hours (default 336 = 14 days)
SESSION_HOURS=336
# Max DB connections per server instance (default 5; keep low on serverless)
# DB_POOL_MAX=5
